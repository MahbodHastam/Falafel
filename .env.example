# Public URL used to build share links.
FALAFEL_BASE_URL=https://falafel.example.com

# Trust X-Forwarded-Proto / -Host / -For from the reverse proxy in front of Falafel.
# Enable only when the proxy is the sole way to reach the server; the last
# X-Forwarded-For entry is used as the client address for rate limits.
# docker compose defaults this to true because it publishes the port on localhost only.
FALAFEL_TRUST_PROXY=false

# Listener and storage (docker compose sets its own values for these two).
FALAFEL_ADDR=:8080
FALAFEL_DB_PATH=./data/falafel.db

# Limits and lifetimes.
FALAFEL_ROOM_TTL=24h
FALAFEL_OWNER_GRACE=10s
FALAFEL_RETENTION=168h
FALAFEL_MAX_FILE_SIZE=10737418240
FALAFEL_MIN_PASSWORD_LENGTH=4

# STUN servers handed to browsers.
FALAFEL_STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302

# TURN relay (optional). Prefer FALAFEL_TURN_SECRET: Falafel then issues credentials that
# expire with the room, matching coturn's `use-auth-secret` / `static-auth-secret`.
# FALAFEL_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# FALAFEL_TURN_SECRET=change-me
# Static credentials work too, but /api/config shows them to every visitor:
# FALAFEL_TURN_USERNAME=falafel
# FALAFEL_TURN_CREDENTIAL=change-me

# Optional base64url HMAC key (at least 16 bytes) for tickets. Generated and stored on first run if empty.
# FALAFEL_SECRET=
